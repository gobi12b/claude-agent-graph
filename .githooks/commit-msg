#!/bin/sh
# Rejects commit messages that aren't Conventional Commits (the same rule CI checks).
subject=$(head -n1 "$1")
case "$subject" in Merge\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;; esac
if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert)(\([^)]+\))?!?: .+'; then
  echo "Commit message isn't a Conventional Commit: $subject" >&2
  echo "Use 'type(scope)?: summary' with type one of feat fix perf refactor docs test build ci chore style revert." >&2
  exit 1
fi
